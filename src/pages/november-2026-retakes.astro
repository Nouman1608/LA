---
import HomeLayout from '../layouts/HomeLayout.astro';
import PageHeader from '../components/sections/PageHeader.astro';
import LandingBody from '../components/sections/LandingBody.astro';
import Faq from '../components/sections/Faq.astro';
import CtaBand from '../components/sections/CtaBand.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import { course } from '../components/seo/schemas';
import { site } from '../data/site';

const title = `Oct/Nov 2026 Retakes in Pakistan — Deadlines & Classes | ${site.name}`;
const description =
  'Cambridge Oct/Nov 2026 entries have closed; Edexcel and OxfordAQA have not. Private-candidate deadlines, how to enter, and online retake classes.';

const points = [
  {
    title: 'Cambridge has closed — Edexcel and OxfordAQA have not',
    body: 'The Cambridge late-entry deadline in Pakistan was 3 September 2026 and has passed. Pearson Edexcel International A Level late entries close 17 September 2026, and both Edexcel GCSE/IGCSE and OxfordAQA IGCSE late entries close 2 October 2026. If you missed Cambridge, you can still sit the November series with another board.',
  },
  {
    title: 'Registering is not enough — you must also pay',
    body: 'British Council Pakistan is explicit: for each stage deadline you need to have paid the fee, not just registered on the online system. Any payment made after the deadline is treated as late and costs more. An unpaid registration is not an entry.',
  },
  {
    title: 'Diagnose before you re-teach',
    body: 'We start by reading your actual paper, component by component, to find where the marks went. Retaking without knowing which paper failed you is how students repeat a grade.',
  },
  {
    title: 'Exam technique, not just content',
    body: 'Most retake marks are lost to command words, timing and working-out, not to gaps in knowledge. Timed past-paper practice with detailed marking is the core of every retake course — and with exams starting 28 September, technique is where the remaining weeks pay.',
  },
  {
    title: 'One subject or several',
    body: 'Most retake students take one or two subjects. There is no requirement to re-sit a full set, and fees are charged per subject.',
  },
];

const faqs = [
  {
    q: 'What is the deadline to register for the Oct/Nov 2026 exams in Pakistan?',
    a: 'It depends on your board. Through British Council Pakistan: Cambridge International closed on 3 September 2026 (late stage). Pearson Edexcel International A Level late entries close 17 September 2026. Pearson Edexcel GCSE/IGCSE late entries close 2 October 2026. OxfordAQA IGCSE late entries close 2 October 2026. For every stage you must have paid the fee by the deadline, not merely registered.',
  },
  {
    q: 'I missed the Cambridge deadline — what are my options?',
    a: 'Three. First, you can still enter the November 2026 series with another board: Edexcel International A Level until 17 September, and Edexcel GCSE/IGCSE or OxfordAQA IGCSE until 2 October — the syllabuses overlap heavily, so most of your preparation transfers. Second, you can request a review of results (remarking) on your June paper if the grade looked wrong; confirm the window with your exam centre. Third, you can sit the Cambridge May/June 2027 series, which gives you eight months of preparation instead of six weeks.',
  },
  {
    q: 'When does the October/November 2026 series run?',
    a: 'Exams run from 28 September 2026 to 13 November 2026. Note that 13 November is when the exam window ends — it is not a registration deadline. Registration closes months earlier, on the dates listed above.',
  },
  {
    q: 'Can I retake just one subject?',
    a: 'Yes. Most of our retake students take one or two subjects. There is no requirement to re-sit a full set.',
  },
  {
    q: 'Does a retake grade replace my old one?',
    a: 'Universities generally see both sittings. Most Pakistani and UK institutions accept your best grade, but policies vary — check with each university directly before you decide.',
  },
  {
    q: 'How do I register as a private candidate in Pakistan?',
    a: 'Through the British Council Pakistan School Registration System. Create an account, select your board and syllabus codes, submit the entry, and pay the fee before the published deadline for your board. Keep the payment receipt — an unpaid entry is not submitted to the board.',
  },
  {
    q: 'How much does retake tuition cost?',
    a: 'The same as our standard rates: PKR 19,000 per month per subject at O Level and IGCSE, and PKR 24,000 per month per subject at A Level. There is 20% off for three or more subjects. One-to-one classes are PKR 3,500 per class at O Level and IGCSE, and PKR 4,000 per class at A Level.',
  },
  {
    q: 'Is there really a free first class?',
    a: 'Yes — one full demo class with the actual teacher who would take you. No card details, no commitment.',
  },
];

const courseSchema = course({
  name: 'Cambridge, Edexcel, OxfordAQA & AQA Oct/Nov 2026 Retake Preparation',
  description:
    'Focused online retake preparation for IGCSE, O Level and A Level students sitting the October/November 2026 series with Cambridge, Pearson Edexcel, OxfordAQA or AQA.',
  url: '/november-2026-retakes/',
});
---

<HomeLayout
  title={title}
  description={description}
  canonical="/november-2026-retakes/"
  topBar={false}
>
  <JsonLd slot="head" data={courseSchema} />

  <PageHeader
    eyebrow="October/November 2026 series"
    crumb="Oct/Nov 2026 Retakes"
    title="Retaking in October/November 2026?"
    sub="Cambridge entries have closed. Edexcel and OxfordAQA are still open — Edexcel International A Level until 17 September, Edexcel IGCSE and OxfordAQA until 2 October."
  />

  <LandingBody
    lead="Results day rarely ends the story. Every year a large share of Pakistani students sit the October/November series to lift a grade for university applications, to move from AS into A2 on firmer ground, or simply to correct a paper that went wrong on the day. If you are planning a November retake right now, the first thing to get straight is which door is still open. Through British Council Pakistan, the Cambridge International late-entry deadline was 3 September 2026 and has passed. Pearson Edexcel International A Level late entries close on 17 September 2026. Pearson Edexcel GCSE/IGCSE and OxfordAQA IGCSE late entries both close on 2 October 2026. For every one of those stages British Council is explicit that you must have paid the fee by the deadline and not just registered on the online system — an unpaid registration is not an entry. Exams themselves run from 28 September to 13 November 2026; that November date is the end of the exam window, not a registration deadline, and mistaking the two is the single most common reason a Pakistani private candidate misses a series. Our retake classes are built around the job that remains: read the paper that produced the grade, isolate the component that cost the marks, and drill it under timed conditions with a teacher who knows the mark scheme."
    pointsTitle="How our retake classes work"
    points={points}
    relatedTitle="Popular retake subjects"
    related={[
      { label: 'Chemistry', href: '/subjects/chemistry/' },
      { label: 'Physics', href: '/subjects/physics/' },
      { label: 'Biology', href: '/subjects/biology/' },
      { label: 'Mathematics', href: '/subjects/mathematics/' },
      { label: 'Economics', href: '/subjects/economics/' },
      { label: 'All subjects', href: '/subjects/' },
    ]}
  />

  <Faq items={faqs} />

  <CtaBand title="Entries close 17 September and 2 October. Book a free class and plan your retake." />
</HomeLayout>
