---
import HomeLayout from '../layouts/HomeLayout.astro';
import Hero from '../components/sections/Hero.astro';
import ResultsBanner from '../components/sections/ResultsBanner.astro';
import BoardStrip from '../components/sections/BoardStrip.astro';
import AboutWhyUs from '../components/sections/AboutWhyUs.astro';
import Boards from '../components/sections/Boards.astro';
import Subjects from '../components/sections/Subjects.astro';
import Team from '../components/sections/Team.astro';
import Pricing from '../components/sections/Pricing.astro';
import CtaBand from '../components/sections/CtaBand.astro';
import TrialContact from '../components/sections/TrialContact.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import { faqPage } from '../components/seo/schemas';

const title = 'Online IGCSE, O & A Level Tuition Pakistan | Learners Academy';
const description =
  'Live online IGCSE, O Level and A Level classes across Cambridge, Edexcel and AQA — expert teachers, 23 subjects, transparent pricing. Book a free demo class.';

const faqs = [
  {
    q: 'Is Learners Academy fully online, or is there a campus in Lahore?',
    a: 'Both — we teach live online across Pakistan, the Gulf and the UK, and also run in-person sessions from our Bahria Town, Lahore campus.',
  },
  {
    q: 'How much does IGCSE or A Level tuition cost per subject?',
    a: '₨19,000/month per subject for IGCSE, ₨24,000/month per subject for A Level. 20% off when you take 3 or more subjects, and 10% off for up to 2 siblings.',
  },
  {
    q: 'Which exam boards do you teach?',
    a: 'Cambridge (CAIE), Edexcel and AQA, across IGCSE, O Level and A Level — 23 subjects in total.',
  },
  {
    q: 'Can students outside Pakistan join?',
    a: 'Yes — we teach students in the UAE, Saudi Arabia, the UK and beyond. Gulf time zones run one to two hours behind Pakistan, so after-school slots line up naturally.',
  },
  {
    q: 'Are classes live or recorded?',
    a: 'Live and interactive — your child attends at a scheduled time and asks questions in real time on a shared whiteboard, then gets the recording afterwards. Homework is set and marked every week.',
  },
  {
    q: 'Is the first class really free?',
    a: 'Yes — every family starts with a free, no-commitment demo class before paying for anything.',
  },
];
---
<HomeLayout title={title} description={description} canonical="/">
  <JsonLd slot="head" data={faqPage(faqs.map((f) => ({ q: f.q, a: f.a })))} />
  <Hero />
  <ResultsBanner />
  <BoardStrip />
  <AboutWhyUs />
  <Boards />
  <Subjects />
  <Team />
  <Pricing />

  <section class="faq">
    <div class="container faq__inner">
      <h2 class="section-title faq__title">Frequently asked questions</h2>
      <div class="faq__list">
        {
          faqs.map((f) => (
            <details class="faq__item">
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand
    title="Loved your experience with us?"
    sub="If Learners Academy has helped your child, a quick Google review helps other Lahore families find us."
    cta="Leave a Google review"
    href="https://g.page/r/CY7Oo82BPlnIEBM/review"
    target="_blank"
    rel="noopener"
  />

  <TrialContact />
</HomeLayout>

<style>
  .faq {
    background: var(--c-bg);
    padding-block: var(--section-y);
  }
  .faq__inner {
    max-width: 760px;
  }
  .faq__title {
    text-align: center;
  }
  .faq__list {
    margin-top: 32px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .faq__item {
    background: #fff;
    border: 1px solid var(--c-border);
    border-radius: var(--r-md);
    padding: 18px 22px;
    box-shadow: var(--shadow-card);
  }
  .faq__item summary {
    cursor: pointer;
    font-weight: 600;
    color: var(--c-primary);
    font-size: 16px;
    list-style: none;
  }
  .faq__item summary::-webkit-details-marker {
    display: none;
  }
  .faq__item summary::after {
    content: '+';
    float: right;
    color: var(--c-accent-soft);
    font-size: 20px;
    line-height: 1;
  }
  .faq__item[open] summary::after {
    content: '–';
  }
  .faq__item p {
    margin: 14px 0 0;
    font-size: 15.5px;
    line-height: 1.7;
  }
</style>
