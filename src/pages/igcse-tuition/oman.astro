---
import HomeLayout from '../../layouts/HomeLayout.astro';
import PageHeader from '../../components/sections/PageHeader.astro';
import Faq from '../../components/sections/Faq.astro';
import CtaBand from '../../components/sections/CtaBand.astro';
import Button from '../../components/ui/Button.astro';
import JsonLd from '../../components/seo/JsonLd.astro';
import { course, breadcrumbList } from '../../components/seo/schemas';
import { site, whatsappLink } from '../../data/site';

const title = `IGCSE Tuition in Oman — Online Classes | ${site.name}`;
const description =
  'Online IGCSE, O Level & A Level tuition for families in Oman. Cambridge & Edexcel specialists, Muscat-friendly timings, WhatsApp-first. Free trial class.';

const courseSchema = course({
  name: 'IGCSE & A Level Online Tuition for Oman Students',
  description:
    'Live online IGCSE, O Level and A Level classes for students in Oman — Cambridge, Edexcel and AQA exam boards.',
  url: `${site.domain}/igcse-tuition/oman/`,
});

const breadcrumb = breadcrumbList([
  { name: 'Home', url: `${site.domain}/` },
  { name: 'IGCSE Tuition Oman', url: `${site.domain}/igcse-tuition/oman/` },
]);

const gaps = [
  {
    title: 'We already teach families in Oman',
    body: 'Oman is one of the countries our overseas students come from, alongside the UAE. You would not be our first family in Muscat — the timings, the payment questions and the exam-centre deadlines are all ground we have covered before.',
  },
  {
    title: 'A community older than most in the Gulf',
    body: 'Around 232,000 Pakistanis live in Oman, and the tie runs deeper than work postings — Gwadar was Omani territory until 1958. Pakistan School Muscat and its sister schools have served that community for decades, and our teachers know exactly the world your child is studying in.',
  },
  {
    title: 'Only one hour behind Pakistan',
    body: 'Oman is the easiest Gulf country for us to schedule. A 6pm class in Muscat is 7pm in Lahore — the middle of our teaching evening, so your child gets the pick of group slots rather than whatever is left over.',
  },
  {
    title: 'WhatsApp-first, priced in rials',
    body: 'Enquiries, scheduling and progress updates all happen on WhatsApp, and fees are quoted in Omani rials — well below what in-person tutoring in Muscat costs for the same number of contact hours.',
  },
];

const help = [
  {
    title: 'At a British or international school',
    body: 'Oman has a long-established circuit of British-curriculum schools — British School Muscat among the best known — all sitting IGCSE and A Level. Whichever your child attends, we teach the official Cambridge, Edexcel or AQA specification their school follows.',
  },
  {
    title: 'At Pakistan School Muscat or a sister school',
    body: 'The Pakistan Schools in Oman have taught the community for generations. We work alongside them: reinforcing school teaching, filling subject gaps, and preparing students who move onto a Cambridge or Edexcel route for the standard those boards expect — including Urdu, Islamiyat and Pakistan Studies.',
  },
  {
    title: 'Studying as a private candidate',
    body: 'Cambridge and Edexcel exams run in Oman through the British Council and approved school centres. We provide complete private-candidate preparation — full syllabus coverage, marked mocks, and reminders well ahead of each registration deadline.',
  },
];

const faqs = [
  {
    q: 'Do you teach students across Oman?',
    a: 'Yes — Muscat, Ruwi, Seeb, Sohar, Salalah, Nizwa and everywhere else in the Sultanate. Classes are live online, so location makes no difference. We have taught students across the Gulf since 2016, Oman included.',
  },
  {
    q: 'How do timings work from Oman?',
    a: 'Oman is only one hour behind Pakistan and schools run Sunday to Thursday. A 6pm class in Muscat is 7pm in Lahore — right in the middle of our teaching evening, which means the widest choice of group slots. The Friday–Saturday weekend works well for 1-to-1 or longer sessions.',
  },
  {
    q: 'Which exam boards and levels do you cover?',
    a: 'Cambridge (CAIE), Pearson Edexcel and AQA, across IGCSE, O Level and A Level. Preparation follows the official specification and syllabus code your child’s school uses.',
  },
  {
    q: 'My child is at Pakistan School Muscat. Can you help?',
    a: 'Yes — supporting students at Pakistani community schools is one of the things we do best. Our teachers know both the classroom culture and the Cambridge and Edexcel marking standards, so lessons reinforce school rather than confuse it. Urdu, Islamiyat and Pakistan Studies are taught alongside the sciences and maths.',
  },
  {
    q: 'Can my child sit exams in Oman as a private candidate?',
    a: 'Yes. Cambridge and Edexcel exams run in Oman through the British Council and approved school centres, which accept private candidates. We cover the syllabus end to end, set timed marked mocks, and keep you ahead of registration deadlines — always confirm the current dates and fees with the centre directly.',
  },
  {
    q: 'What does it cost from Oman?',
    a: 'OMR 28.000 per subject per month for IGCSE and O Level, and OMR 34.000 for A Level, billed monthly — substantially below local in-person tutoring. Take 20% off from three subjects and 10% for a second sibling. Message us on WhatsApp and we will confirm the total for your subject list and the simplest way to pay from Oman.',
  },
  {
    q: 'Do you teach A Level students in Oman too?',
    a: 'Yes — group and 1-to-1 A Level classes across sciences, maths, economics, business and more, for Cambridge and Edexcel. Many families continue with us from IGCSE straight through Years 12–13.',
  },
  {
    q: 'How do we start?',
    a: 'Book a free trial class. WhatsApp us your child’s subjects, year group and exam board, and we reply the same day with options on Oman-friendly timings.',
  },
];
---
<HomeLayout title={title} description={description} canonical="/igcse-tuition/oman/" topBar={false}>
  <JsonLd slot="head" data={courseSchema} />
  <JsonLd slot="head" data={breadcrumb} />
  <PageHeader
    eyebrow="IGCSE tuition · Oman"
    crumb="IGCSE Tuition Oman"
    title="IGCSE tuition in Oman, live and online."
    sub="Cambridge, Edexcel and AQA classes for families across the Sultanate — evening timings, WhatsApp-first communication, teachers who know your child's board."
    rating
  />

  <section class="guide">
    <div class="container container--narrow">
      <p class="guide__lead">
        Oman is already one of the countries our overseas students come from. Around 232,000
        Pakistanis live in the Sultanate — a community older than most in the Gulf, with its own
        schools in Muscat and beyond — and Oman sits just one hour behind Pakistan, which makes it
        the easiest Gulf country of all for us to timetable. What Muscat does not have is a deep
        bench of subject specialists at IGCSE and A Level. Live online tuition closes that gap:
        experienced Pakistani teachers, official specifications, evening slots that fit the Omani
        school week.
      </p>

      <h2 class="guide__h2">Why families in Oman choose us</h2>
      <div class="guide__grid">
        {
          gaps.map((g) => (
            <div class="gcard">
              <h3 class="gcard__title">{g.title}</h3>
              <p class="gcard__body">{g.body}</p>
            </div>
          ))
        }
      </div>

      <h2 class="guide__h2">Whatever your child&rsquo;s school situation</h2>
      <div class="guide__stack">
        {
          help.map((h) => (
            <div class="gcard">
              <h3 class="gcard__title">{h.title}</h3>
              <p class="gcard__body">{h.body}</p>
            </div>
          ))
        }
      </div>

      <h2 class="guide__h2">How it works from Oman</h2>
      <p class="guide__text">
        Send a WhatsApp message with your child&rsquo;s subjects, year group and exam board. We
        reply the same day with group options on Oman-friendly evening slots, or 1-to-1 timings of
        your choice including the Friday–Saturday weekend. Classes are live and interactive,
        homework is marked weekly, and past-paper practice builds up ahead of the May/June exam
        session — with October/November available for retakes.
      </p>
      <div class="guide__actions">
        <Button href={whatsappLink("Hi! I'm in Oman and would like to ask about IGCSE classes.")} variant="primary" size="lg">
          WhatsApp us from Oman
        </Button>
        <a class="guide__plink" href="/pricing/">See pricing →</a>
      </div>

      <h2 class="guide__h2">Also for families in the Gulf</h2>
      <div class="related__links">
        <a class="related__link" href="/igcse-tuition/dubai/">IGCSE tuition in Dubai &amp; UAE <span aria-hidden="true">→</span></a>
        <a class="related__link" href="/igcse-tuition/saudi-arabia/">IGCSE tuition in Saudi Arabia <span aria-hidden="true">→</span></a>
        <a class="related__link" href="/igcse-tuition/qatar/">IGCSE tuition in Qatar <span aria-hidden="true">→</span></a>
        <a class="related__link" href="/igcse-tuition/kuwait/">IGCSE tuition in Kuwait <span aria-hidden="true">→</span></a>
        <a class="related__link" href="/igcse-tuition/bahrain/">IGCSE tuition in Bahrain <span aria-hidden="true">→</span></a>
        <a class="related__link" href="/pakistani-expats/">All countries — Pakistani expats hub <span aria-hidden="true">→</span></a>
        <a class="related__link" href="/subjects/">All subjects &amp; boards <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <Faq items={faqs} />
  <CtaBand
    title="Serious preparation, wherever in Oman you live."
    sub="Book a free trial class — meet the teacher, see the method, no commitment."
  />
</HomeLayout>

<style>
  .guide {
    background: var(--c-bg);
    padding-block: var(--section-y);
  }
  .guide__lead {
    margin: 0 auto;
    max-width: 70ch;
    font-size: clamp(18px, 1.9vw, 21px);
    line-height: 1.7;
    color: var(--c-text);
  }
  .guide__h2 {
    margin: 56px 0 24px;
    font-size: clamp(26px, 3vw, 36px);
    line-height: 1.1;
    color: var(--c-primary-ink);
  }
  .guide__text {
    max-width: 70ch;
    line-height: 1.7;
    color: var(--c-text);
  }
  .guide__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 16px;
  }
  .guide__stack {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .gcard {
    background: var(--c-card);
    border: 1px solid var(--c-border);
    border-radius: 14px;
    padding: 22px;
  }
  .gcard__title {
    margin: 0 0 8px;
    font-size: 19px;
    color: var(--c-primary-ink);
  }
  .gcard__body {
    margin: 0;
    line-height: 1.65;
    color: var(--c-text);
  }
  .guide__actions {
    margin-top: 28px;
    display: flex;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
  }
  .guide__plink {
    font-weight: 600;
    color: var(--c-primary);
  }
  .related__links {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .related__link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
    color: var(--c-primary);
  }
</style>
