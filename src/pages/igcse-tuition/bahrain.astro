---
import HomeLayout from '../../layouts/HomeLayout.astro';
import PageHeader from '../../components/sections/PageHeader.astro';
import Faq from '../../components/sections/Faq.astro';
import CtaBand from '../../components/sections/CtaBand.astro';
import Button from '../../components/ui/Button.astro';
import JsonLd from '../../components/seo/JsonLd.astro';
import { course, breadcrumbList } from '../../components/seo/schemas';
import { site, whatsappLink } from '../../data/site';

const title = `IGCSE Tuition in Bahrain — Online Classes | ${site.name}`;
const description =
  'Online IGCSE, O Level & A Level tuition for families in Bahrain. Cambridge & Edexcel specialists, Bahrain-friendly timings, WhatsApp-first. Free trial class.';

const courseSchema = course({
  name: 'IGCSE & A Level Online Tuition for Bahrain Students',
  description:
    'Live online IGCSE, O Level and A Level classes for students in Bahrain — Cambridge, Edexcel and AQA exam boards.',
  url: `${site.domain}/igcse-tuition/bahrain/`,
});

const breadcrumb = breadcrumbList([
  { name: 'Home', url: `${site.domain}/` },
  { name: 'IGCSE Tuition Bahrain', url: `${site.domain}/igcse-tuition/bahrain/` },
]);

const gaps = [
  {
    title: 'A small island, a very small tutor pool',
    body: 'Bahrain is the smallest Gulf market, and the specialist bench shows it. A family in Riffa looking for an Edexcel further maths or Cambridge physics teacher is often choosing between one or two names — or none. Online, the subject specialist is a scheduling question, not a geography one.',
  },
  {
    title: 'One of the oldest Pakistani communities in the Gulf',
    body: 'Around 110,000 Pakistanis live in Bahrain, with two long-established community schools — Pakistan School Bahrain and Pakistan Urdu School. Our teachers know that world: the classroom culture at home, and the Cambridge and Edexcel marking standards your child is actually examined against.',
  },
  {
    title: 'Built around the Bahrain week',
    body: 'Bahrain is two hours behind Pakistan and schools run Sunday to Thursday. A 6pm class in Manama is 8pm in Lahore — comfortably inside our teaching day — and the Friday–Saturday weekend suits longer 1-to-1 sessions.',
  },
  {
    title: 'WhatsApp-first, priced in dinars',
    body: 'Enquiries, scheduling and progress updates all happen on WhatsApp, and fees are quoted in Bahraini dinars — well below what in-person tutoring in Bahrain costs for the same number of contact hours.',
  },
];

const help = [
  {
    title: 'At a British or international school',
    body: 'Bahrain has a deep circuit of British-curriculum schools — the British School of Bahrain and St Christopher’s School among the best known — all sitting IGCSE and A Level. Whichever your child attends, we teach the official Cambridge, Edexcel or AQA specification their school follows.',
  },
  {
    title: 'At a Pakistani community school',
    body: 'Pakistan School Bahrain and Pakistan Urdu School have served the community for decades. We work alongside them: reinforcing school teaching, filling subject gaps, and preparing students who move onto a Cambridge or Edexcel route for the standard those boards expect.',
  },
  {
    title: 'Studying as a private candidate',
    body: 'Cambridge and Edexcel exams run in Bahrain through the British Council and approved centres. We provide complete private-candidate preparation — full syllabus coverage, marked mocks, and reminders well ahead of each registration deadline.',
  },
];

const faqs = [
  {
    q: 'Do you teach students across Bahrain?',
    a: 'Yes — Manama, Riffa, Muharraq, Isa Town, Hamad Town, Saar and everywhere else on the island. Classes are live online, so location makes no difference. We have taught students across the Gulf since 2016.',
  },
  {
    q: 'How do timings work from Bahrain?',
    a: 'Bahrain is two hours behind Pakistan and schools run Sunday to Thursday. A 6pm class in Manama is 8pm in Lahore, comfortably inside our teaching day — and the Friday–Saturday weekend works well for 1-to-1 or longer sessions.',
  },
  {
    q: 'Which exam boards and levels do you cover?',
    a: 'Cambridge (CAIE), Pearson Edexcel and AQA, across IGCSE, O Level and A Level. Preparation follows the official specification and syllabus code your child’s school uses.',
  },
  {
    q: 'My child is at Pakistan School Bahrain. Can you help?',
    a: 'Yes — supporting students at Pakistani community schools is one of the things we do best. Our teachers know both the classroom culture and the Cambridge and Edexcel marking standards, so lessons reinforce school rather than confuse it.',
  },
  {
    q: 'Can my child sit exams in Bahrain as a private candidate?',
    a: 'Yes. Cambridge and Edexcel exams run in Bahrain through the British Council and other approved centres, which accept private candidates. We cover the syllabus end to end, set timed marked mocks, and keep you ahead of registration deadlines — always confirm the current dates and fees with the centre directly.',
  },
  {
    q: 'What does it cost from Bahrain?',
    a: 'BHD 27.500 per subject per month for IGCSE and O Level, and BHD 33.500 for A Level, billed monthly — substantially below local in-person tutoring. Take 20% off from three subjects and 10% for a second sibling. Message us on WhatsApp and we will confirm the total for your subject list and the simplest way to pay from Bahrain.',
  },
  {
    q: 'Do you teach A Level students in Bahrain too?',
    a: 'Yes — group and 1-to-1 A Level classes across sciences, maths, economics, business and more, for Cambridge and Edexcel. Many families continue with us from IGCSE straight through Years 12–13.',
  },
  {
    q: 'How do we start?',
    a: 'Book a free trial class. WhatsApp us your child’s subjects, year group and exam board, and we reply the same day with options on Bahrain-friendly timings.',
  },
];
---
<HomeLayout title={title} description={description} canonical="/igcse-tuition/bahrain/" topBar={false}>
  <JsonLd slot="head" data={courseSchema} />
  <JsonLd slot="head" data={breadcrumb} />
  <PageHeader
    eyebrow="IGCSE tuition · Bahrain"
    crumb="IGCSE Tuition Bahrain"
    title="IGCSE tuition in Bahrain, live and online."
    sub="Cambridge, Edexcel and AQA classes for families across Bahrain — evening timings, WhatsApp-first communication, teachers who know your child's board."
    rating
  />

  <section class="guide">
    <div class="container container--narrow">
      <p class="guide__lead">
        Bahrain has around 110,000 Pakistanis, two community schools of its own, and one of the
        densest concentrations of British-curriculum education in the Gulf relative to its size.
        What it does not have is depth of subject tutors. On an island this small, a family
        looking for a strong Cambridge chemistry or Edexcel maths teacher is often choosing from
        a shortlist of one. Live online tuition closes that gap: experienced Pakistani teachers,
        official specifications, evening slots that fit the Bahrain school week.
      </p>

      <h2 class="guide__h2">Why families in Bahrain choose us</h2>
      <div class="guide__grid">
        {
          gaps.map((g) => (
            <div class="gcard">
              <h3 class="gcard__title">{g.title}</h3>
              <p class="gcard__body">{g.body}</p>
            </div>
          ))
        }
      </div>

      <h2 class="guide__h2">Whatever your child&rsquo;s school situation</h2>
      <div class="guide__stack">
        {
          help.map((h) => (
            <div class="gcard">
              <h3 class="gcard__title">{h.title}</h3>
              <p class="gcard__body">{h.body}</p>
            </div>
          ))
        }
      </div>

      <h2 class="guide__h2">How it works from Bahrain</h2>
      <p class="guide__text">
        Send a WhatsApp message with your child&rsquo;s subjects, year group and exam board. We
        reply the same day with group options on Bahrain-friendly evening slots, or 1-to-1 timings
        of your choice including the Friday–Saturday weekend. Classes are live and interactive,
        homework is marked weekly, and past-paper practice builds up ahead of the May/June exam
        session — with October/November available for retakes.
      </p>
      <div class="guide__actions">
        <Button href={whatsappLink("Hi! I'm in Bahrain and would like to ask about IGCSE classes.")} variant="primary" size="lg">
          WhatsApp us from Bahrain
        </Button>
        <a class="guide__plink" href="/pricing/">See pricing →</a>
      </div>

      <h2 class="guide__h2">Also for families in the Gulf</h2>
      <div class="related__links">
        <a class="related__link" href="/igcse-tuition/kuwait/">IGCSE tuition in Kuwait <span aria-hidden="true">→</span></a>
        <a class="related__link" href="/igcse-tuition/qatar/">IGCSE tuition in Qatar <span aria-hidden="true">→</span></a>
        <a class="related__link" href="/igcse-tuition/dubai/">IGCSE tuition in Dubai &amp; UAE <span aria-hidden="true">→</span></a>
        <a class="related__link" href="/igcse-tuition/saudi-arabia/">IGCSE tuition in Saudi Arabia <span aria-hidden="true">→</span></a>
        <a class="related__link" href="/igcse-tuition/oman/">IGCSE tuition in Oman <span aria-hidden="true">→</span></a>
        <a class="related__link" href="/pakistani-expats/">All countries — Pakistani expats hub <span aria-hidden="true">→</span></a>
        <a class="related__link" href="/subjects/">All subjects &amp; boards <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <Faq items={faqs} />
  <CtaBand
    title="Serious preparation, wherever in Bahrain you live."
    sub="Book a free trial class — meet the teacher, see the method, no commitment."
  />
</HomeLayout>

<style>
  .guide {
    background: var(--c-bg);
    padding-block: var(--section-y);
  }
  .guide__lead {
    margin: 0 auto;
    max-width: 70ch;
    font-size: clamp(18px, 1.9vw, 21px);
    line-height: 1.7;
    color: var(--c-text);
  }
  .guide__h2 {
    margin: 56px 0 24px;
    font-size: clamp(26px, 3vw, 36px);
    line-height: 1.1;
    color: var(--c-primary-ink);
  }
  .guide__text {
    max-width: 70ch;
    line-height: 1.7;
    color: var(--c-text);
  }
  .guide__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 16px;
  }
  .guide__stack {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .gcard {
    background: var(--c-card);
    border: 1px solid var(--c-border);
    border-radius: 14px;
    padding: 22px;
  }
  .gcard__title {
    margin: 0 0 8px;
    font-size: 19px;
    color: var(--c-primary-ink);
  }
  .gcard__body {
    margin: 0;
    line-height: 1.65;
    color: var(--c-text);
  }
  .guide__actions {
    margin-top: 28px;
    display: flex;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
  }
  .guide__plink {
    font-weight: 600;
    color: var(--c-primary);
  }
  .related__links {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .related__link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
    color: var(--c-primary);
  }
</style>
