---
/** Time-boxed results-season banner.
 *
 *  Astro renders the phase that is correct at BUILD time, then the small
 *  inline script at the bottom re-checks the date in the visitor's browser and
 *  rewrites the copy if the site has not been rebuilt since the phase changed.
 *  No manual deploy is needed on 18 Aug, 3 Sep or 13 Nov 2026 — the banner
 *  advances itself. With JavaScript disabled the build-time phase still shows,
 *  so the worst case is the old behaviour, never a blank banner.
 *
 *  Boundaries are UTC midnight (05:00 PKT), matching the original logic.
 *  Renders nothing after 13 Nov 2026. */
import Button from '../ui/Button.astro';

/** [phase, exclusive end date]. Single source of truth — the build-time render
 *  and the runtime script below both read this, so they cannot drift apart. */
const PHASES = [
  ['pre', '2026-08-11'],
  ['aLevel', '2026-08-18'],
  ['igcse', '2026-09-03'],
  ['retakes', '2026-11-13'],
] as const;

type Phase = (typeof PHASES)[number][0];

const nowMs = Date.now();
const phase: Phase | null =
  PHASES.find(([, end]) => nowMs < Date.parse(`${end}T00:00:00Z`))?.[0] ?? null;

const copy = {
  pre: {
    eyebrow: 'Results season',
    title: 'A Level results land 11 August. IGCSE & O Level on 18 August.',
    sub: 'Whatever the envelope says, you have options — remarks, retakes and AS-to-A2 planning all have deadlines that arrive sooner than families expect.',
    cta: 'Read the results-day guide',
    href: '/blog/caie-results-day-2026-pakistan/',
  },
  aLevel: {
    eyebrow: 'A Level results are out',
    title: 'Got your A Level result? Here is what to do next.',
    sub: 'Remark deadlines and Oct/Nov retake entries close faster than most families realise. IGCSE and O Level results follow on 18 August.',
    cta: 'Read the results-day guide',
    href: '/blog/caie-results-day-2026-pakistan/',
  },
  igcse: {
    eyebrow: 'IGCSE & O Level results are out',
    title: 'Results in hand? Plan the next step before the deadlines close.',
    sub: 'Cambridge late entries for the Oct/Nov series close on 3 September in Pakistan, and remark requests on 18 September.',
    cta: 'See retake options',
    href: '/november-2026-retakes/',
  },
  retakes: {
    eyebrow: 'October/November 2026 series',
    title: 'Retaking this November? Three months is enough — six weeks is not.',
    sub: 'Focused retake classes across 23 subjects, built around the paper that cost you the marks.',
    cta: 'See retake options',
    href: '/november-2026-retakes/',
  },
} as const;

const c = phase ? copy[phase] : null;
---

{
  c && (
    <section class="rbanner" data-rbanner>
      <div class="container rbanner__inner">
        <div class="rbanner__text">
          <p class="rbanner__eyebrow" data-rbanner-eyebrow>{c.eyebrow}</p>
          <h2 class="rbanner__title" data-rbanner-title>{c.title}</h2>
          <p class="rbanner__sub" data-rbanner-sub>{c.sub}</p>
        </div>
        <div class="rbanner__cta">
          <Button href={c.href} variant="white" data-rbanner-cta>
            {c.cta}
          </Button>
        </div>
      </div>
    </section>
  )
}

{/* Advances the banner without a rebuild. Runs inline, right after the markup,
    so there is no flash of stale copy. Fails closed: any error leaves the
    build-time phase in place. */}
<script is:inline define:vars={{ phases: PHASES, copy, builtPhase: phase }}>
  (function () {
    try {
      var el = document.querySelector('[data-rbanner]');
      if (!el) return;

      var now = Date.now();
      var live = null;
      for (var i = 0; i < phases.length; i++) {
        if (now < Date.parse(phases[i][1] + 'T00:00:00Z')) {
          live = phases[i][0];
          break;
        }
      }

      if (!live) {
        el.remove();
        return;
      }
      if (live === builtPhase) return;

      var c = copy[live];
      if (!c) return;

      var set = function (sel, text) {
        var node = el.querySelector(sel);
        if (node) node.textContent = text;
      };
      set('[data-rbanner-eyebrow]', c.eyebrow);
      set('[data-rbanner-title]', c.title);
      set('[data-rbanner-sub]', c.sub);

      var cta = el.querySelector('[data-rbanner-cta]');
      if (cta) {
        cta.textContent = c.cta;
        cta.setAttribute('href', c.href);
      }
    } catch (e) {
      /* leave the build-time banner untouched */
    }
  })();
</script>

<style>
  .rbanner {
    background: var(--c-primary-dark, #3a4885);
    color: #fff;
    border-block: 1px solid rgba(255, 255, 255, 0.12);
  }
  .rbanner__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    padding-block: 26px;
    flex-wrap: wrap;
  }
  .rbanner__text {
    max-width: 62ch;
  }
  .rbanner__eyebrow {
    margin: 0 0 6px;
    font-size: 12px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--c-accent, #d8b46a);
  }
  .rbanner__title {
    margin: 0;
    font-size: clamp(19px, 2.2vw, 25px);
    line-height: 1.25;
    font-weight: 500;
    color: #fff;
  }
  .rbanner__sub {
    margin: 8px 0 0;
    font-size: 15px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.82);
  }
  .rbanner__cta {
    flex-shrink: 0;
  }
  @media (max-width: 720px) {
    .rbanner__inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 18px;
    }
  }
</style>
